{
  "name": "@aigestion/three-daniela",
  "version": "0.1.0",
  "description": "Reusable React Three Fiber components for Daniela OS (neural particles, core orb, orbit rings, starfield)",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "import": "./dist/index.mjs", "require": "./dist/index.js", "types": "./dist/index.d.ts" },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": ["**/*.css"],
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "three": ">=0.160.0",
    "@react-three/fiber": ">=8.0.0"
  },
  "devDependencies": {
    "@types/three": "^0.166.0",
    "@types/react": "^18.3.0",
    "react": "^19.0.0",
    "three": "^0.166.0",
    "@react-three/fiber": "^8.16.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  },
  "license": "MIT"
}
