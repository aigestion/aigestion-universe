# Daniela Sandbox
SANDBOX_PORT=8090
LOG_LEVEL=info

# Default execution limits
DEFAULT_TIMEOUT_S=30
DEFAULT_MAX_OUTPUT_BYTES=1048576
DEFAULT_MAX_MEMORY_MB=512
DEFAULT_WORKDIR=/tmp/daniela-sandbox

# Docker executor (set to enable container isolation)
SANDBOX_DOCKER_IMAGE=python:3.13-slim
# Network: allow | none | bridge
DEFAULT_NETWORK=none

# Audit
AUDIT_RETENTION=1000
