# Admin - admin.aigestion.net (restricted)
admin.aigestion.net {
    @websockets {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    encode zstd gzip
    reverse_proxy daniela-shell:3000
    # basicauth is configured via environment variable at runtime
    # basicauth /* {env.ADMIN_HTPASSWD}
}