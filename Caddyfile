{
    admin off
    local_certs
}

# Landing page - aigestion.net
aigestion.net {
    @websockets {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    encode zstd gzip
    root * /var/www/landing
    try_files {path} /index.html
    file_server
    
    # Security headers for landing
    header {
        Strict-Transport-Security max-age=31536000
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Permissions-Policy interest-cohort=()
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' wss: https://api.aigestion.net;"
    }
}

# Daniela Shell - shell.aigestion.net
shell.aigestion.net {
    @websockets {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    encode zstd gzip
    reverse_proxy daniela-shell:3000
    
    header {
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' wss: https://api.aigestion.net;"
    }
}

