# === AIGESTION UNIVERSE - Environment ===
# Copiar a .env y rellenar valores reales. NUNCA commitear .env.

# Core
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql://daniela:changeme@postgres:5432/daniela
REDIS_URL=redis://redis:6379/0
ENVIRONMENT=production
LOG_LEVEL=info

# Grafana admin password (se mounta como secret)
ADMIN_HTPASSWD=changeme

# BYOK provider keys (opcional - se inyectan via secret manager en prod)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Android pairing (PC <-> Pixel challenge-response)
PIXEL_TOKEN=change-me-to-a-long-random-secret

# APK release URL
APK_URL=https://github.com/aigestion/daniela-android/releases/latest/download/daniela.apk
