{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".next/**", "*.wasm"],
      "cache": true
    },
    "build:python": {
      "dependsOn": ["^build:python"],
      "outputs": ["dist/**", "*.egg-info", ".venv/**"],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": []
    },
    "test:python": {
      "outputs": ["coverage/**", ".pytest_cache/**"],
      "dependsOn": []
    },
    "lint": {},
    "lint:python": {},
    "typecheck": {},
    "typecheck:python": {},
    "deploy": {
      "dependsOn": ["build", "test", "lint", "typecheck"]
    },
    "docker:build": {
      "dependsOn": ["build"]
    }
  },
  "globalEnv": ["NODE_ENV", "DATABASE_URL", "REDIS_URL", "SECRET_KEY"]
}
